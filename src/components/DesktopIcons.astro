---
const RESUME_HREF = '/Mason_Rivera_Resume.pdf';
---

<div class="desktop-icons">
	<a class="desktop-icon" href={RESUME_HREF} target="_blank" rel="noopener noreferrer" title="Open resume (PDF)">
		<span class="desktop-icon-glyph" aria-hidden="true">
			<svg viewBox="0 0 16 16">
				<path d="M3 1h6l4 4v10H3z" fill="none" stroke="currentColor" stroke-width="1.2"></path>
				<path d="M9 1v4h4" fill="none" stroke="currentColor" stroke-width="1.2"></path>
				<path d="M5 8h6M5 10.5h6M5 13h4" stroke="currentColor" stroke-width="1.1"></path>
			</svg>
		</span>
		<span class="desktop-icon-label">Resume.pdf</span>
	</a>
	<button type="button" class="desktop-icon" data-open-mail title="Email Mason">
		<span class="desktop-icon-glyph" aria-hidden="true">
			<svg viewBox="0 0 16 16">
				<rect x="1.5" y="3" width="13" height="10" fill="none" stroke="currentColor" stroke-width="1.2"></rect>
				<path d="M1.5 3l6.5 5.5L14.5 3" fill="none" stroke="currentColor" stroke-width="1.2"></path>
			</svg>
		</span>
		<span class="desktop-icon-label">Mail.app</span>
	</button>
</div>
